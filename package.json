{
  "name": "anibt-wiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check:openapi && next build --webpack",
    "build:worker": "opennextjs-cloudflare build --openNextConfigPath open-next.cloudflare.config.ts && opennextjs-cloudflare populateCache local",
    "preview": "wrangler dev",
    "deploy": "wrangler deploy",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "gen:openapi": "tsx scripts/generate-openapi.ts",
    "check:openapi": "tsx scripts/generate-openapi.ts --check && node scripts/check-openapi.mjs",
    "test:openapi": "node --import tsx --test scripts/openapi/check.test.mjs scripts/openapi/examples.test.mjs scripts/openapi/llm.test.mjs scripts/openapi/rendering.test.mjs",
    "check:openapi:live": "node scripts/openapi/live.mjs"
  },
  "dependencies": {
    "@fontsource/m-plus-1-code": "^5.3.1",
    "@fumadocs/language": "^0.2.16",
    "@orama/tokenizers": "^3.1.18",
    "@pierre/highlights": "^0.2.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "fumadocs-core": "^16.17.8",
    "fumadocs-mdx": "^15.4.10",
    "fumadocs-openapi": "^12.5.5",
    "fumadocs-ui": "^16.17.8",
    "lucide-react": "^1.61.0",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "ajv": "^8.20.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0",
    "yaml": "^2.9.1"
  }
}
